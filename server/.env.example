# W.E.D.N.E.S.D.A.Y. Pro - Environment Configuration
# Copy this file to .env in the server/ directory

PORT=5001
NODE_ENV=development

# Security Handshake Token
AUTH_TOKEN=wednesday-secret-local-handshake-token-2026

# AI LLM Provider API Keys (Optional - System uses fallback chain if not set)
OPENAI_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=

# Search Engine API Key (Optional - System falls back to Wikipedia/DuckDuckGo)
SEARCH_API_KEY=

# Image Generation Key (Optional)
STABILITY_API_KEY=
